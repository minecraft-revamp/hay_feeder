{
  "multipart": [
    { "apply": { "model": "hay_feeder:block/hay_feeder_floor" } },
    { "when": { "OR": [{ "north": "false" }, { "east": "false" }, { "diag_ne": "false" }] }, "apply": { "model": "hay_feeder:block/hay_feeder_corner_ne" } },
    { "when": { "OR": [{ "north": "false" }, { "west": "false" }, { "diag_nw": "false" }] }, "apply": { "model": "hay_feeder:block/hay_feeder_corner_nw" } },
    { "when": { "OR": [{ "south": "false" }, { "east": "false" }, { "diag_se": "false" }] }, "apply": { "model": "hay_feeder:block/hay_feeder_corner_se" } },
    { "when": { "OR": [{ "south": "false" }, { "west": "false" }, { "diag_sw": "false" }] }, "apply": { "model": "hay_feeder:block/hay_feeder_corner_sw" } },
    { "when": { "north": "false" }, "apply": { "model": "hay_feeder:block/hay_feeder_wall_north" } },
    { "when": { "south": "false" }, "apply": { "model": "hay_feeder:block/hay_feeder_wall_south" } },
    { "when": { "east":  "false" }, "apply": { "model": "hay_feeder:block/hay_feeder_wall_east"  } },
    { "when": { "west":  "false" }, "apply": { "model": "hay_feeder:block/hay_feeder_wall_west"  } },
    { "when": { "fill_stage": "half" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half" } },
    { "when": { "fill_stage": "full" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full" } },

    { "when": { "fill_stage": "half", "north": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_north" } },
    { "when": { "fill_stage": "half", "south": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_south" } },
    { "when": { "fill_stage": "half", "east":  "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_east"  } },
    { "when": { "fill_stage": "half", "west":  "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_west"  } },
    { "when": { "fill_stage": "full", "north": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_north" } },
    { "when": { "fill_stage": "full", "south": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_south" } },
    { "when": { "fill_stage": "full", "east":  "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_east"  } },
    { "when": { "fill_stage": "full", "west":  "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_west"  } },

    { "when": { "fill_stage": "half", "north": "true", "east": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_corner_ne" } },
    { "when": { "fill_stage": "half", "north": "true", "west": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_corner_nw" } },
    { "when": { "fill_stage": "half", "south": "true", "east": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_corner_se" } },
    { "when": { "fill_stage": "half", "south": "true", "west": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_half_ext_corner_sw" } },
    { "when": { "fill_stage": "full", "north": "true", "east": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_corner_ne" } },
    { "when": { "fill_stage": "full", "north": "true", "west": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_corner_nw" } },
    { "when": { "fill_stage": "full", "south": "true", "east": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_corner_se" } },
    { "when": { "fill_stage": "full", "south": "true", "west": "true" }, "apply": { "model": "hay_feeder:block/hay_feeder_contents_full_ext_corner_sw" } }
  ]
}
